{
  "name": "sofa",
  "productName": "Sofa",
  "version": "1.1.0",
  "description": "A controller-first home screen that turns a Windows gaming PC into a console.",
  "author": "AGregDev",
  "license": "MIT",
  "repository": "github:AGregDev/sofa",
  "homepage": "https://github.com/AGregDev/sofa",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "qa": "electron . --shots",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "app.sofa.launcher",
    "productName": "Sofa",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-web.js",
      "src/**",
      "renderer/**",
      "assets/**",
      "!assets/blender/**"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "*.ps1"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sofa",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0"
  }
}
